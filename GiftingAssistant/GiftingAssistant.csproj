<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharedUtilities\SharedUtilities.Baseline.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GiftingAssistant</AssemblyName>
    <RootNamespace>GiftingAssistant</RootNamespace>
    <LangVersion>latest</LangVersion>
    <SunhavenModUiProject>true</SunhavenModUiProject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SunHaven.Core">
      <HintPath>$(ManagedPath)\SunHaven.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedPath)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedUtilities\CharacterSaveStore.cs" Link="Shared\CharacterSaveStore.cs" />
    <Compile Include="..\SharedUtilities\VersionChecker.cs" Link="Shared\VersionChecker.cs" />
    <Compile Include="..\SharedUtilities\TodoManagerReflection.cs" Link="Shared\TodoManagerReflection.cs" />
    <Compile Include="..\SharedUtilities\TodoSoftClient.cs" Link="Shared\TodoSoftClient.cs" />
    <Compile Include="..\SharedUtilities\SceneRootSurvivor.cs" Link="Shared\SceneRootSurvivor.cs" />
    <Compile Include="..\SharedUtilities\GameSaveCharacterName.cs" Link="Shared\GameSaveCharacterName.cs" />
    <Compile Include="..\SharedUtilities\MinimalJsonParser.cs" Link="Shared\MinimalJsonParser.cs" />
    <Compile Include="..\SharedUtilities\ItemSearch.cs" Link="Shared\ItemSearch.cs" />
    <Compile Include="..\SharedUtilities\IconCache.cs" Link="Shared\IconCache.cs" />
    <Compile Include="..\SharedUtilities\OvernightHookUtility.cs" Link="Shared\OvernightHookUtility.cs" />
    <Compile Include="..\SharedUtilities\TextInputFocusGuard.cs" Link="Shared\TextInputFocusGuard.cs" />
    <Compile Include="..\SharedUtilities\ModLocalization.cs" Link="Shared\ModLocalization.cs" />
    <Compile Include="..\SharedUtilities\LanguageChangeWatcher.cs" Link="Shared\LanguageChangeWatcher.cs" />
    <Compile Include="..\SharedUtilities\LocalizationBootstrap.cs" Link="Shared\LocalizationBootstrap.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartRules.cs" Link="Shared\RelationshipHeartRules.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartLayout.cs" Link="Shared\RelationshipHeartLayout.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartAssetLoader.cs" Link="Shared\RelationshipHeartAssetLoader.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartRenderer.cs" Link="Shared\RelationshipHeartRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\strings.json">
      <LogicalName>com.azraelgodking.giftingassistant.Localization.strings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\GiftingAssistant" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\GiftingAssistant" />
    <ItemGroup>
      <GiftingAssets Include="$(MSBuildProjectDirectory)\Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(GiftingAssets)" DestinationFolder="$(BepInExPath)\plugins\GiftingAssistant\Assets\%(RecursiveDir)" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GiftingAssets)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\GiftingAssistant\Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins and builds folder" Importance="High" />
  </Target>
</Project>
