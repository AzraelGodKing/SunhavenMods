<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharedUtilities\SharedUtilities.Baseline.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HavensAlmanac</AssemblyName>
    <RootNamespace>HavensAlmanac</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- CS0436: We compile SharedUtilities and reference other mods (BirthdayReminder, etc.); those DLLs also embed VersionChecker/ReflectionHelper. We use our copy. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <SunhavenModUiProject>true</SunhavenModUiProject>
  </PropertyGroup>

  <!-- BepInEx References -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity References -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game References -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Soft dependencies: compile against sibling projects so `dotnet build` works without `builds/<Mod>/*.dll`. -->
  <ItemGroup>
    <ProjectReference Include="..\SunhavenTodo\SunhavenTodo.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\BirthdayReminder\BirthdayReminder.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\SunHavenMuseumUtilityTracker\SunHavenMuseumUtilityTracker.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\SenpaisChest\SenpaisChest.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\TheVault\TheVault.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\HavensBirthright\HavensBirthright.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\HavenDevTools\HavenDevTools.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\CropOptimizer\CropOptimizer.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\GiftingAssistant\GiftingAssistant.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Exclude decompiled reference files: kept in _refs/ as dnSpy dumps for -->
  <!-- local debugging of game internals, never compiled into the plugin DLL.  -->
  <ItemGroup>
    <Compile Remove="_refs\**\*.cs" />
    <None Include="_refs\**\*.cs" />
  </ItemGroup>

  <!-- Shared Utilities (linked files) -->
  <ItemGroup>
    <Compile Include="..\SharedUtilities\OvernightHookUtility.cs" Link="Shared\OvernightHookUtility.cs" />
    <Compile Include="..\SharedUtilities\ModHealthAggregator.cs" Link="Shared\ModHealthAggregator.cs" />
    <Compile Include="..\SharedUtilities\VersionChecker.cs" Link="Shared\VersionChecker.cs" />
    <Compile Include="..\SharedUtilities\SceneRootSurvivor.cs" Link="Shared\SceneRootSurvivor.cs" />
    <Compile Include="..\SharedUtilities\GUIStyleHelper.cs" Link="Shared\GUIStyleHelper.cs" />
    <Compile Include="..\SharedUtilities\TextInputFocusGuard.cs" Link="Shared\TextInputFocusGuard.cs" />
    <Compile Include="..\SharedUtilities\MinimalJsonParser.cs" Link="Shared\MinimalJsonParser.cs" />
    <Compile Include="..\SharedUtilities\ModLocalization.cs" Link="Shared\ModLocalization.cs" />
    <Compile Include="..\SharedUtilities\LanguageChangeWatcher.cs" Link="Shared\LanguageChangeWatcher.cs" />
    <Compile Include="..\SharedUtilities\LocalizationBootstrap.cs" Link="Shared\LocalizationBootstrap.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartRules.cs" Link="Shared\RelationshipHeartRules.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartLayout.cs" Link="Shared\RelationshipHeartLayout.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartAssetLoader.cs" Link="Shared\RelationshipHeartAssetLoader.cs" />
    <Compile Include="..\SharedUtilities\RelationshipHeartRenderer.cs" Link="Shared\RelationshipHeartRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\strings.json">
      <LogicalName>com.azraelgodking.havensalmanac.Localization.strings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy to BepInEx plugins folder and builds folder after build -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\HavensAlmanac" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\HavensAlmanac" />
    <ItemGroup>
      <AlmanacAssets Include="$(MSBuildProjectDirectory)\Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AlmanacAssets)" DestinationFolder="$(BepInExPath)\plugins\HavensAlmanac\Assets\%(RecursiveDir)" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AlmanacAssets)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\HavensAlmanac\Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins and builds folder" Importance="High" />
  </Target>

</Project>
