<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharedUtilities\SharedUtilities.Baseline.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TheVault</AssemblyName>
    <RootNamespace>TheVault</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>4.3.1</Version>
    <AssemblyVersion>4.3.1.0</AssemblyVersion>
    <FileVersion>4.3.1.0</FileVersion>
    <InformationalVersion>4.3.1</InformationalVersion>
    <SunhavenModUiProject>true</SunhavenModUiProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheVault.Abstractions\TheVault.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectDirectory)\**\*.cs" Exclude="$(MSBuildProjectDirectory)\Decomplied\**;$(MSBuildProjectDirectory)\Decompiled\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\Tests\**" />
    <Compile Include="..\SharedUtilities\CharacterSaveStore.cs" Link="Shared\CharacterSaveStore.cs" />
    <Compile Include="..\SharedUtilities\VersionChecker.cs" Link="Shared\VersionChecker.cs" />
    <Compile Include="..\SharedUtilities\SceneRootSurvivor.cs" Link="Shared\SceneRootSurvivor.cs" />
    <Compile Include="..\SharedUtilities\IconCache.cs" Link="Shared\IconCache.cs" />
    <Compile Include="..\SharedUtilities\TextInputFocusGuard.cs" Link="Shared\TextInputFocusGuard.cs" />
    <Compile Include="..\SharedUtilities\MinimalJsonParser.cs" Link="Shared\MinimalJsonParser.cs" />
    <Compile Include="..\SharedUtilities\VaultCryptography.cs" Link="Shared\VaultCryptography.cs" />
    <Compile Include="..\SharedUtilities\VaultCsvault3.cs" Link="Shared\VaultCsvault3.cs" />
    <Compile Include="..\SharedUtilities\ModLocalization.cs" Link="Shared\ModLocalization.cs" />
    <Compile Include="..\SharedUtilities\LanguageChangeWatcher.cs" Link="Shared\LanguageChangeWatcher.cs" />
    <Compile Include="..\SharedUtilities\LocalizationBootstrap.cs" Link="Shared\LocalizationBootstrap.cs" />
    <EmbeddedResource Include="Localization\strings.json">
      <LogicalName>com.azraelgodking.thevault.Localization.strings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SunHaven.Core">
      <HintPath>$(ManagedPath)\SunHaven.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedPath)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\TheVault" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\TheVault" />
    <Copy SourceFiles="$(TargetDir)TheVault.Abstractions.dll" DestinationFolder="$(BepInExPath)\plugins\TheVault" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true' And Exists('$(TargetDir)TheVault.Abstractions.dll')" />
    <Copy SourceFiles="$(TargetDir)TheVault.Abstractions.dll" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\TheVault" Condition="Exists('$(TargetDir)TheVault.Abstractions.dll')" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins and builds folder" Importance="High" />
  </Target>

</Project>
